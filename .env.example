# AI Skill Passport — environment template
# Copy this file to .env and fill in your own values.
# NEVER commit .env (it is listed in .gitignore). Only .env.example is shared.

# --- Browser (these are public: VITE_ variables are baked into the front-end bundle) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# --- Server (read by server functions and SSR) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# --- Server only, optional: bypasses row level security. Keep it secret. ---
# Only needed if you use src/integrations/supabase/client.server.ts (admin operations).
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: only for scheduled/cron endpoints ---
LOVABLE_CRON_SECRET=
